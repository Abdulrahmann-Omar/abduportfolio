---
const groups = [
  {
    label: 'Languages',
    items: ['Python', 'SQL', 'TypeScript', 'C++'],
  },
  {
    label: 'LLMs & Agents',
    items: ['LangChain', 'LlamaIndex', 'CrewAI', 'DSPy', 'Pydantic AI', 'OpenAI & Anthropic APIs', 'Fine-tuning (QLoRA)', 'vLLM'],
  },
  {
    label: 'RAG & Retrieval',
    items: ['FAISS', 'ChromaDB', 'pgvector', 'Pinecone', 'Neo4j', 'Hybrid retrieval', 'Ragas evaluation'],
  },
  {
    label: 'Backend & MLOps',
    items: ['FastAPI', 'PostgreSQL', 'Redis', 'Docker', 'GCP Cloud Run', 'Modal', 'Supabase', 'CI/CD'],
  },
  {
    label: 'ML & Data',
    items: ['PyTorch', 'Scikit-learn', 'Hugging Face', 'Apache Spark', 'Pandas', 'SHAP / LIME'],
  },
  {
    label: 'Frontend',
    items: ['Next.js', 'React', 'Tailwind CSS', 'Astro'],
  },
];
---

<section id="skills" class="border-b border-line py-20 md:py-28">
  <div class="mx-auto max-w-content px-6">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl" data-reveal>
      What I work with
    </h2>

    <dl class="mt-12 divide-y divide-white/[0.06] border-y border-line" data-reveal>
      {groups.map((group) => (
        <div class="grid gap-2 py-5 md:grid-cols-[200px_1fr] md:gap-10">
          <dt class="font-mono text-sm text-ink-mute">{group.label}</dt>
          <dd class="flex flex-wrap gap-x-2 gap-y-1.5">
            {group.items.map((item, i) => (
              <span class="text-[15px] text-ink-soft">
                {item}{i < group.items.length - 1 && <span class="ml-2 text-white/20" aria-hidden="true">·</span>}
              </span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
