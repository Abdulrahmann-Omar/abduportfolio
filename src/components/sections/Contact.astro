---
const base = import.meta.env.BASE_URL;
---

<section id="contact" class="py-20 md:py-28">
  <div class="mx-auto max-w-content px-6">
    <p class="kicker mb-3" data-reveal>Contact</p>
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl" data-reveal>
      Let's build something
    </h2>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft" data-reveal>
      Whether it's a production LLM system, an AI product from zero to launch, or a hard retrieval
      problem — I'm happy to talk.
    </p>

    <div class="mt-10" data-reveal>
      <a
        href="mailto:abdu.omar.muhammad@gmail.com"
        class="break-all font-display text-xl font-medium text-accent underline-offset-8 hover:underline sm:text-2xl md:text-3xl"
      >
        abdu.omar.muhammad@gmail.com
      </a>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-ink-mute" data-reveal>
      <a href="tel:+201098081484" class="link-quiet">+20 109 808 1484</a>
      <span>Cairo, Egypt · working remotely</span>
      <a href="https://github.com/Abdulrahmann-Omar" class="link-quiet" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://linkedin.com/in/abdulrahman-omar-87121b200" class="link-quiet" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={`${base}ABDULRAHMAN-OMAR-Resume.pdf`} download="Abdulrahman-Omar-Resume.pdf" class="link-quiet">Resume (PDF)</a>
    </div>
  </div>
</section>
