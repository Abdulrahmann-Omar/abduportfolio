<section id="experience" class="border-b border-line py-20 md:py-28">
  <div class="mx-auto max-w-content px-6">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl" data-reveal>
      Where I've worked
    </h2>

    <ol class="mt-12">
      {experiences.map((item) => (
        <li class="grid gap-2 border-l border-line py-8 pl-6 first:pt-0 md:grid-cols-[200px_1fr] md:gap-10 md:pl-10" data-reveal>
          <div class="relative">
            <span class="absolute -left-[29px] top-1.5 h-2 w-2 rounded-full bg-accent md:-left-[45px]" aria-hidden="true"></span>
            <p class="font-mono text-sm text-ink-mute">{item.period}</p>
            <p class="mt-1 text-sm text-ink-mute md:mt-2">{item.location}</p>
          </div>

          <div>
            <h3 class="text-lg font-semibold text-ink">
              {item.role}
              <span class="font-normal text-ink-soft">
                {' · '}
                <a href={item.companyUrl} class="transition-colors hover:text-accent" target="_blank" rel="noopener noreferrer">
                  {item.company}
                </a>
              </span>
            </h3>
            <ul class="mt-3 space-y-2.5 text-[15px] leading-relaxed text-ink-soft">
              {item.description.map((line) => (
                <li class="flex gap-2.5">
                  <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-white/25" aria-hidden="true"></span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
