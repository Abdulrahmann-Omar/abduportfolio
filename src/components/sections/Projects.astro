---
const base = import.meta.env.BASE_URL;

const projects = [
  {
    title: 'Everyside',
    subtitle: 'Arabic-native AI Marketing OS',
    role: 'Co-Founder & CTO · 2025–present',
    description:
      'Define your brand once; the platform designs, writes, and launches on-brand campaigns in Arabic and English. Nothing publishes without human approval.',
    highlights: [
      'FastAPI + Pydantic v2 backend, LLM generation, Arq background jobs, Paymob billing, GCP Cloud Run',
      'Ad-channel publishing for Meta, TikTok, and Snap; bilingual RTL-aware EN/AR product UI',
    ],
    tags: ['FastAPI', 'Next.js', 'Pydantic AI', 'Supabase', 'Redis', 'GCP'],
    links: [{ label: 'everyside.ai', href: 'https://everyside.ai', external: true }],
    media: 'video',
  },
  {
    title: 'Pulse',
    subtitle: 'Multi-agent marketing platform',
    role: 'Creator & Lead Engineer · Team of 4 · 2025',
    description:
      'Production-grade multi-agent platform for social-media marketing: specialized autonomous agents for content, strategy, analytics, and research over a FastAPI backend.',
    highlights: [
      'Fine-tuned an 8B LLM via knowledge distillation + QLoRA on A100s; self-hosted with vLLM and Modal',
      'Fault-tolerant LLM gateway with multi-provider failover and per-agent model policies',
    ],
    tags: ['CrewAI', 'DSPy', 'vLLM', 'QLoRA', 'pgvector', 'Docker'],
    links: [{ label: 'GitHub', href: 'https://github.com/pulse-mas/pulse-multi-agent-platform', external: true }],
    media: 'agents',
  },
  {
    title: 'NeuraViva',
    subtitle: 'News-driven multi-stock forecasting',
    role: 'Solo project · 2024',
    description:
      'End-to-end framework integrating financial-news sentiment with multi-stock time-series forecasting, reaching 0.02 MSE with SHAP/LIME explainability throughout.',
    highlights: [
      'SVM, XGBoost, Random Forest, and linear baselines benchmarked on a shared harness',
      'Sentiment features fused with price history; attributions audited per prediction',
    ],
    tags: ['PyTorch', 'XGBoost', 'NLP', 'SHAP', 'Time Series'],
    links: [
      {
        label: 'GitHub',
        href: 'https://github.com/Abdulrahmann-Omar/FinSentImpact-A-News-Driven-Multi-Stock-Forecasting-Framework',
        external: true,
      },
    ],
    media: 'forecast',
  },
  {
    title: 'Fraud Detection',
    subtitle: 'Imbalanced-data fraud models',
    role: 'Solo project · 2024',
    description:
      'Up to 98% precision on the IEEE-CIS dataset with a 0.17% fraud rate; false negatives cut by 18% against the baseline, with SHAP reporting for every model.',
    highlights: [
      'SMOTE, class-weighted XGBoost, and neural baselines compared honestly on the same splits',
      'Decision thresholds tuned to the asymmetric cost of a missed fraud',
    ],
    tags: ['Scikit-learn', 'XGBoost', 'SMOTE', 'SHAP'],
    links: [
      { label: 'GitHub', href: 'https://github.com/Abdulrahmann-Omar/Fraud_Detection_With_Various_Models', external: true },
    ],
    media: 'anomaly',
  },
];
---

<section id="work" class="border-b border-line py-20 md:py-28">
  <div class="mx-auto max-w-content px-6">
    <p class="kicker mb-3" data-reveal>Selected work</p>
    <h2 class="font-display text-3xl font-semibold tracking-tight text-ink md:text-4xl" data-reveal>
      Things I've built and shipped
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <article
          class="group flex flex-col overflow-hidden rounded-lg border border-line bg-surface transition-colors duration-300 hover:border-line-strong"
          data-reveal
        >
          <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-canvas">
            {project.media === 'video' ? (
              <video
                class="h-full w-full object-cover"
                src={`${base}media/everyside-tour.mp4`}
                poster={`${base}media/everyside-poster.jpg`}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label="Everyside product tour"
              />
            ) : (
              <svg class="h-full w-full" viewBox="0 0 640 360" role="img" aria-label={`${project.title} illustration`} preserveAspectRatio="xMidYMid slice">
                <rect width="640" height="360" fill="#0d0e11" />
                <g stroke="rgba(255,255,255,0.05)">
                  {Array.from({ length: 15 }, (_, i) => (
                    <line x1={i * 46} y1="0" x2={i * 46} y2="360" />
                  ))}
                  {Array.from({ length: 9 }, (_, i) => (
                    <line x1="0" y1={i * 46} x2="640" y2={i * 46} />
                  ))}
                </g>
                {project.media === 'agents' && (
                  <g>
                    <g stroke="rgba(139,147,255,0.35)" stroke-width="1.2">
                      <line x1="320" y1="180" x2="180" y2="100" />
                      <line x1="320" y1="180" x2="470" y2="90" />
                      <line x1="320" y1="180" x2="150" y2="260" />
                      <line x1="320" y1="180" x2="480" y2="270" />
                      <line x1="180" y1="100" x2="470" y2="90" />
                      <line x1="150" y1="260" x2="480" y2="270" />
                    </g>
                    <circle cx="320" cy="180" r="14" fill="#8b93ff" />
                    <circle cx="180" cy="100" r="8" fill="none" stroke="#8b93ff" stroke-width="2" />
                    <circle cx="470" cy="90" r="8" fill="none" stroke="#8b93ff" stroke-width="2" />
                    <circle cx="150" cy="260" r="8" fill="none" stroke="#8b93ff" stroke-width="2" />
                    <circle cx="480" cy="270" r="8" fill="none" stroke="#8b93ff" stroke-width="2" />
                    <circle cx="320" cy="180" r="28" fill="none" stroke="rgba(139,147,255,0.25)" stroke-width="1" />
                  </g>
                )}
                {project.media === 'forecast' && (
                  <g>
                    <polyline
                      points="60,270 140,240 220,255 300,190 380,205 460,140 540,120 590,90"
                      fill="none"
                      stroke="#8b93ff"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <polyline
                      points="60,290 140,285 220,300 300,250 380,265 460,225 540,215 590,190"
                      fill="none"
                      stroke="rgba(255,255,255,0.25)"
                      stroke-width="1.5"
                      stroke-dasharray="4 5"
                    />
                    <g fill="#8b93ff">
                      <circle cx="300" cy="190" r="4" />
                      <circle cx="460" cy="140" r="4" />
                      <circle cx="590" cy="90" r="4" />
                    </g>
                  </g>
                )}
                {project.media === 'anomaly' && (
                  <g>
                    <g fill="rgba(255,255,255,0.28)">
                      {[
                        [95, 250], [150, 225], [205, 265], [250, 205], [305, 245],
                        [355, 215], [415, 255], [465, 230], [520, 260], [560, 235],
                        [130, 285], [280, 280], [390, 285], [490, 290], [230, 235],
                      ].map(([x, y]) => (
                        <circle cx={x} cy={y} r="5" />
                      ))}
                    </g>
                    <circle cx="430" cy="105" r="7" fill="#8b93ff" />
                    <circle cx="430" cy="105" r="18" fill="none" stroke="rgba(139,147,255,0.5)" stroke-width="1.5" />
                    <circle cx="430" cy="105" r="32" fill="none" stroke="rgba(139,147,255,0.2)" stroke-width="1" />
                  </g>
                )}
              </svg>
            )}
          </div>

          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-display text-xl font-semibold text-ink">
                  {project.title}
                  <span class="font-sans text-base font-normal text-ink-mute"> — {project.subtitle}</span>
                </h3>
                <p class="mt-1 font-mono text-xs text-ink-mute">{project.role}</p>
              </div>
              <div class="flex shrink-0 items-center gap-3 pt-1">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    class="inline-flex items-center gap-1 text-sm text-accent underline-offset-4 hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H9m8 0v8" />
                    </svg>
                  </a>
                ))}
              </div>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-ink-soft">{project.description}</p>

            <ul class="mt-4 space-y-2 text-sm text-ink-mute">
              {project.highlights.map((h) => (
                <li class="flex gap-2.5">
                  <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto flex flex-wrap gap-2 pt-5">
              {project.tags.map((tag) => (
                <span class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-ink-mute">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Respect reduced motion: don't loop the product video for those users.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('#work video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }
</script>
