---
const base = import.meta.env.BASE_URL;

const links = [
  { name: 'Work', href: '#work' },
  { name: 'Experience', href: '#experience' },
  { name: 'Research', href: '#research' },
  { name: 'Skills', href: '#skills' },
  { name: 'Contact', href: '#contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-canvas/80 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-content items-center justify-between px-6" aria-label="Main">
    <a href="#main" class="font-display text-lg font-semibold tracking-tight text-ink" aria-label="Abdulrahman Omar — back to top">
      Abdulrahman<span class="text-accent">.</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {links.map((link) => (
        <a href={link.href} class="nav-link text-sm text-ink-soft transition-colors hover:text-ink" data-nav={link.href}>
          {link.name}
        </a>
      ))}
      <a
        href={`${base}ABDULRAHMAN-OMAR-Resume.pdf`}
        download="Abdulrahman-Omar-Resume.pdf"
        class="rounded-md border border-line-strong px-3.5 py-1.5 text-sm text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Resume
      </a>
    </div>

    <button
      id="menu-toggle"
      class="text-ink-soft hover:text-ink md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path id="menu-icon-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        <path id="menu-icon-close" class="hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-canvas px-6 pb-6 pt-2 md:hidden">
    <div class="flex flex-col">
      {links.map((link) => (
        <a href={link.href} class="border-b border-line py-3 text-ink-soft transition-colors hover:text-ink" data-nav={link.href}>
          {link.name}
        </a>
      ))}
      <a
        href={`${base}ABDULRAHMAN-OMAR-Resume.pdf`}
        download="Abdulrahman-Omar-Resume.pdf"
        class="mt-4 rounded-md border border-line-strong px-4 py-2.5 text-center text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Download Resume
      </a>
    </div>
  </div>
</header>

<style>
  .nav-link[aria-current='true'] {
    color: theme('colors.ink.DEFAULT');
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const closeMenu = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) closeMenu();
    else {
      menu?.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });

  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  // Scroll spy
  const navLinks = document.querySelectorAll('[data-nav]');
  const sections = [...navLinks]
    .map((l) => document.querySelector(l.getAttribute('data-nav') ?? ''))
    .filter(Boolean);

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navLinks.forEach((l) =>
          l.setAttribute('aria-current', l.getAttribute('data-nav') === `#${entry.target.id}` ? 'true' : 'false')
        );
      }
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );
  sections.forEach((s) => spy.observe(s));
</script>
