---
import '../styles/global.css';
import Navigation from '../components/sections/Navigation.astro';

const {
  title = 'Abdulrahman Omar — AI Engineer & CTO',
  description = 'AI Engineer and startup CTO building production LLM systems: natural-language analytics, RAG pipelines, and multi-agent platforms.',
} = Astro.props;

const site = 'https://abdulrahmann-omar.github.io/abduportfolio/';

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Abdulrahman Omar',
  jobTitle: 'AI Engineer & CTO',
  url: site,
  email: 'mailto:abdu.omar.muhammad@gmail.com',
  sameAs: [
    'https://github.com/Abdulrahmann-Omar',
    'https://linkedin.com/in/abdulrahman-omar-87121b200',
  ],
  worksFor: [
    { '@type': 'Organization', name: 'BrightBrainsIT' },
    { '@type': 'Organization', name: 'Everyside' },
  ],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Zewail City of Science and Technology' },
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={site} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script type="application/ld+json" set:html={personSchema} />
  </head>

  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-canvas"
    >
      Skip to content
    </a>

    <Navigation />

    <main id="main">
      <slot />
    </main>

    <script>
      // Reveal-on-scroll (no-op for reduced motion: CSS already shows content)
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
