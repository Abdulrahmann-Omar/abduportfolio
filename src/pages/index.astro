---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Research from '../components/sections/Research.astro';
import Skills from '../components/sections/Skills.astro';
import Contact from '../components/sections/Contact.astro';
---

<Layout>
  <Hero />
  <Projects />
  <Experience />
  <Research />
  <Skills />
  <Contact />

  <footer class="border-t border-line py-10">
    <div class="mx-auto flex max-w-content flex-col items-center justify-between gap-4 px-6 text-sm text-ink-mute sm:flex-row">
      <p>&copy; {new Date().getFullYear()} Abdulrahman Omar</p>
      <div class="flex items-center gap-6">
        <a href="https://github.com/Abdulrahmann-Omar" class="link-quiet" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/abdulrahman-omar-87121b200" class="link-quiet" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="mailto:abdu.omar.muhammad@gmail.com" class="link-quiet">Email</a>
      </div>
    </div>
  </footer>
</Layout>
